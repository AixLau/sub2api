+def _timed_auth_step(function):
+    @wraps(function)
+    def measured(self, *args, **kwargs):
+        started = time.perf_counter()
+        success = False
+        try:
+            result = function(self, *args, **kwargs)
+            success = True
+            return result
+        finally:
+            logging.getLogger("account_import.timing").info(
+                "auth_step_done flow=%x stage=%s elapsed_ms=%d completed=%s",
+                id(self), function.__name__,
+                round((time.perf_counter() - started) * 1000), success,
+            )
+    return measured
